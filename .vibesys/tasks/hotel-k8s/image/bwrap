#!/bin/sh
# Stand-in for bubblewrap inside the job image.
#
# The oracle's managed lifecycle starts "the candidate" as
#   bwrap --unshare-pid ... /bin/sh -c <supervisor> vibesys-candidate-supervisor <command...>
# to contain a local daemon's process tree. Here the candidate is not a local
# process: <command> is `run.py ctl start`, which scales Deployments of the
# cluster and exits, so there is no tree to contain. A job container also
# cannot create the PID namespace (no user namespaces under docker's default
# profile), and the supervisor script would wait forever for processes of the
# container that are not its own. So this shim accepts exactly the options the
# lifecycle passes, enters --chdir, drops the supervisor wrapper, and runs
# <command> directly. Any other option is refused.
while [ "$#" -gt 0 ]; do
  case "$1" in
    --unshare-pid|--die-with-parent) shift ;;
    --ro-bind|--bind|--dev-bind) shift 3 ;;
    --proc) shift 2 ;;
    --chdir) cd "$2" || exit 1; shift 2 ;;
    -*) echo "bwrap shim: unsupported option $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
if [ "$1" = /bin/sh ] && [ "$2" = -c ] && [ "$4" = vibesys-candidate-supervisor ]; then
  shift 4
fi
exec "$@"
